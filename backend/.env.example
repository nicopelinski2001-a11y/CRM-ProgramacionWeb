# URL de conexion a PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/parcial_web?schema=public"

# Puerto donde corre el servidor Express
PORT=4000

# Secreto para firmar los JWT (cambiar por uno propio y largo en produccion)
JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# Tiempo de expiracion del token
JWT_EXPIRES_IN="1h"

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN="http://localhost:5173"

# Opcionales. En producción: NODE_ENV=production y CORS_ORIGIN con HTTPS.
NODE_ENV="development"
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=900000
