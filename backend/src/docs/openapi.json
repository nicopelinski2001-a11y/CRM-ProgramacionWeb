  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthResult": {
        "type": "object",
        "required": ["user", "token"],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "description": "JWT. Enviar en Authorization: Bearer <token>. No compartirlo ni guardarlo en la documentación."
          }
        }
      },
      "RegisterInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 15,
            "description": "Máximo 72 bytes UTF-8; se almacena únicamente el hash bcrypt."
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "createdAt",
          "updatedAt",
          "name",
          "company",
          "email",
          "phone",
          "notes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "example": "Lucía Demo"
          },
          "company": {
            "type": "string",
            "maxLength": 100,
            "example": "Estudio Sur",
            "nullable": true
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "lucia.demo@example.com"
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "example": "+54 351 555 0100",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "example": "Enviar propuesta el viernes.",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["PROSPECT", "FOLLOW_UP", "CLIENT"],
            "default": "PROSPECT"
          }
        }
      },
      "CreateCustomer": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "example": "Lucía Demo"
          },
          "company": {
            "type": "string",
            "maxLength": 100,
            "example": "Estudio Sur"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "lucia.demo@example.com"
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "example": "+54 351 555 0100"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "example": "Enviar propuesta el viernes."
          },
          "status": {
            "type": "string",
            "enum": ["PROSPECT", "FOLLOW_UP", "CLIENT"],
            "default": "PROSPECT"
          }
        },
        "description": "El servidor normaliza espacios y email. Ignora campos ajenos al formulario, incluido userId; el dueño viene del token."
      },
      "UpdateCustomer": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "example": "Lucía Demo"
          },
          "company": {
            "type": "string",
            "maxLength": 100,
            "example": "Estudio Sur"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "lucia.demo@example.com"
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "example": "+54 351 555 0100"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "example": "Enviar propuesta el viernes."
          },
          "status": {
            "type": "string",
            "enum": ["PROSPECT", "FOLLOW_UP", "CLIENT"],
            "default": "PROSPECT"
          }
        },
        "description": "Actualización parcial: enviar al menos un campo permitido. Campos desconocidos se descartan antes de comprobar esta condición."
      },
      "Item": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "createdAt",
          "updatedAt",
          "title",
          "description",
          "completed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
