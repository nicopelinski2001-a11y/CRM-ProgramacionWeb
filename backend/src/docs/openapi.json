{
  "openapi": "3.0.3",
  "info": {
    "title": "Órbita CRM API",
    "version": "2.0.0",
    "description": "CRM de contactos para Programación Web. Primero registrar o iniciar sesión, copiar data.token y usar Authorize. Las operaciones protegidas solo acceden a recursos propios. No usar datos personales reales durante la demostración."
  },
  "servers": [
    {
      "url": "/",
      "description": "El mismo servidor que sirve esta documentación"
    }
  ],
  "tags": [
    {
      "name": "Estado"
    },
    {
      "name": "Autenticación"
    },
    {
      "name": "Contactos"
    },
    {
      "name": "Legado: tareas",
      "description": "Compatibilidad del primer parcial; no se usa en la interfaz CRM."
    }
  ],
