      "get": {
        "tags": ["Estado"],
        "summary": "Comprobar que el proceso HTTP responde (no prueba PostgreSQL)",
        "security": [],
        "responses": {
          "200": {
            "description": "Servidor disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": ["ok"]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
